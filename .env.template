# ─────────────────────────────────────────────
# Crypto DCA Bot — Variables de entorno
# Copia este archivo como .env y rellena los valores
# NUNCA subas .env a git
# ─────────────────────────────────────────────

# Bybit API
BYBIT_API_KEY=tu_api_key_aqui
BYBIT_API_SECRET=tu_api_secret_aqui
BYBIT_TESTNET=false          # true para probar en testnet sin dinero real

# Telegram
TELEGRAM_BOT_TOKEN=123456789:AABBCCDDEEFFaabbccddeeff-xxxxxxxxx
TELEGRAM_CHAT_ID=tu_chat_id_aqui  # número entero, ej: 123456789

# Deadman switch externo (v2.18) — OPCIONAL, vacío = desactivado.
# URL de ping de healthchecks.io (u otro servicio equivalente). El bot la
# pinguea al final de cada scan exitoso; si los pings paran más de ~30 min,
# el servicio alerta. Configurar el check con period 15min + grace 15min.
# Es una capability URL: quien la tenga puede falsificar heartbeats.
HEARTBEAT_URL=

# DCA montos diarios (USD)
DCA_BTC_USD=1.50
DCA_ETH_USD=1.25

# Horario DCA (UTC)
DCA_HOUR_UTC=6
DCA_MINUTE_UTC=0

# Monitor de posiciones (minutos)
MONITOR_INTERVAL_MINUTES=15

# Apalancamiento máximo recomendado (nunca superar 3)
LEVERAGE_MAX=2

# Base de datos SQLite
DB_PATH=trades.db
